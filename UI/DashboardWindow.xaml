<Window x:Class="ZeroTouchLock.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zero-Touch BLE Dynamic Lock — Telemetry &amp; Calibration Dashboard"
        Width="960" Height="730"
        MinWidth="860" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#0F121C"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <!-- Modern Dark Card Container Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#171C2B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#252D43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#242C3F"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#384461"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323D57"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2536"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Top Header & Stat Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Center Oscilloscope Chart -->
            <RowDefinition Height="*"/>
            <!-- Bottom Controls & Config Grid -->
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP HEADER & METRIC STAT CARDS                             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- State Badge Card -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PROXIMITY STATE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border x:Name="StateBadgeBorder" Background="#064E3B" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                        <TextBlock x:Name="StateBadgeText" Text="PRESENT" FontWeight="Bold" FontSize="14" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Filtered RSSI Stat -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FILTERED RSSI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="FilteredRssiText" Text="-- dBm" FontSize="20" FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text="Kalman Smoothed" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Raw RSSI Stat -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RAW RSSI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="RawRssiText" Text="-- dBm" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Last Packet RX" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Estimated Distance Stat -->
            <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ESTIMATED DISTANCE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="DistanceText" Text="-- m" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"/>
                    <TextBlock Text="Log-Distance Model" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Human Activity Guard Stat -->
            <Border Grid.Column="4" Style="{StaticResource ModernCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HUMAN ACTIVITY GUARD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="IdleTimeText" Text="Idle: 0.0s" FontSize="18" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock x:Name="GuardStatusText" Text="Guard Active (&lt; 3.0s)" FontSize="10" Foreground="#34D399"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 2. REAL-TIME RSSI OSCILLOSCOPE CHART                          -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="0">
            <Grid>
                <!-- Canvas for plotting waveforms, gridlines, and thresholds -->
                <Canvas x:Name="OscilloscopeCanvas" ClipToBounds="True" Background="#111522" SizeChanged="OnCanvasSizeChanged"/>

                <!-- Chart Legend (Top-Right overlay) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
                    <!-- Filtered RSSI -->
                    <Rectangle Width="14" Height="4" Fill="#00E676" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Filtered (Kalman)" FontSize="11" Foreground="#CBD5E1" Margin="0,0,16,0"/>

                    <!-- Raw RSSI -->
                    <Rectangle Width="14" Height="2" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Raw Signal" FontSize="11" Foreground="#CBD5E1" Margin="0,0,16,0"/>

                    <!-- Warning Threshold -->
                    <Line X1="0" Y1="0" X2="14" Y2="0" Stroke="#EAB308" StrokeThickness="2" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Warning Line" FontSize="11" Foreground="#EAB308" Margin="0,0,16,0"/>

                    <!-- Away Threshold -->
                    <Line X1="0" Y1="0" X2="14" Y2="0" Stroke="#EF4444" StrokeThickness="2" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Away (Lock) Line" FontSize="11" Foreground="#EF4444"/>
                </StackPanel>

                <!-- Chart Title (Top-Left overlay) -->
                <TextBlock Text="LIVE RSSI TELEMETRY OSCILLOSCOPE (Last 60s)"
                           FontSize="11" FontWeight="Bold" Foreground="#64748B"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 3. CONFIG & QUICK CALIBRATION GRID                            -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bottom Left: Interactive Calibration & Sliders -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Target Device Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Target Device:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" FontSize="12"/>
                        <ComboBox Grid.Column="1" x:Name="DeviceComboBox" Background="#1E2538" Foreground="#F1F5F9" Height="28"/>
                        <Button Grid.Column="2" Content="Rescan" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnRescanDevicesClicked"/>
                    </Grid>

                    <!-- Sliders Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Warning Threshold Slider -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,6">
                            <Grid>
                                <TextBlock Text="Warning Threshold (dBm):" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="WarningSliderVal" Text="-72 dBm" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#EAB308"/>
                            </Grid>
                            <Slider x:Name="WarningSlider" Minimum="-95" Maximum="-45" Value="-72" SmallChange="1" ValueChanged="OnSliderValueChanged"/>
                        </StackPanel>

                        <!-- Away Threshold Slider -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="Away Lock Threshold (dBm):" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="AwaySliderVal" Text="-78 dBm" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                            </Grid>
                            <Slider x:Name="AwaySlider" Minimum="-100" Maximum="-50" Value="-78" SmallChange="1" ValueChanged="OnSliderValueChanged"/>
                        </StackPanel>

                        <!-- Away Duration Slider -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,6">
                            <Grid>
                                <TextBlock Text="Away Duration (seconds):" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="AwayDurationSliderVal" Text="3.5s" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                            </Grid>
                            <Slider x:Name="AwayDurationSlider" Minimum="1.0" Maximum="15.0" Value="3.5" SmallChange="0.5" ValueChanged="OnSliderValueChanged"/>
                        </StackPanel>

                        <!-- Kalman Smoothing R Slider -->
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="Kalman Filter Noise R (Smoothness):" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="KalmanRSliderVal" Text="2.0" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                            </Grid>
                            <Slider x:Name="KalmanRSlider" Minimum="0.1" Maximum="10.0" Value="2.0" SmallChange="0.1" ValueChanged="OnSliderValueChanged"/>
                        </StackPanel>

                        <!-- Stealth Overlay Checkbox -->
                        <CheckBox Grid.Column="0" Grid.Row="2" x:Name="EnableOverlayCheck" Content="Enable Stealth Overlay (Screen dimming on Warning)"
                                  Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- Save & Apply Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <TextBlock x:Name="SaveStatusText" Text="" VerticalAlignment="Center" Foreground="#34D399" Margin="0,0,12,0" FontSize="11"/>
                        <Button Content="Save &amp; Apply Config" Style="{StaticResource AccentButton}" Click="OnSaveAndApplyClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Right: Quick Test & Calibration Controls -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QUICK ACTIONS &amp; CALIBRATION" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <!-- Calibrate Here Button -->
                    <Button Content="🎯 Calibrate Here (Present Position)" Style="{StaticResource AccentButton}"
                            Background="#059669" Margin="0,0,0,8" Click="OnCalibrateHereClicked"
                            ToolTip="Uses current RSSI to set optimal Warning (-6dBm) and Away (-12dBm) thresholds."/>

                    <!-- Test Overlay Button -->
                    <Button Content="🛡️ Test Stealth Overlay (3s Preview)" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,8" Click="OnTestOverlayClicked"
                            ToolTip="Triggers the click-through transparent screen dimming overlay for 3 seconds."/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pause Toggle Button -->
                        <Button Grid.Column="0" x:Name="PauseButton" Content="⏸️ Pause Lock"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="OnPauseToggleClicked"/>

                        <!-- Lock Workstation Button -->
                        <Button Grid.Column="1" Content="🔒 Lock Now"
                                Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="OnLockNowClicked"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
